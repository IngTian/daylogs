__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
# Regenerated by any `uv run` in the project, and consumed by nothing: CI installs from
# pyproject.toml on purpose, so a dependency that exists only in a lockfile has to fail
# there rather than in daily use. Committing it added a file that nothing reads and that
# would quietly go stale. It arrived by accident — `uv run` wrote it and `git add -A` took
# it — which is the whole argument for ignoring it rather than maintaining it.
uv.lock
docs/
.superpowers/
# Local Claude Code settings for this checkout. Machine-specific, never shared.
.claude/
.DS_Store
*.spec
dist_check/

# daylogs's own data, in case anyone ever points DAYLOGS_HOME at the checkout.
# Nothing here is currently tracked; this keeps it that way.
*.db
*.db-journal
config.toml
memory.md
inbox/
